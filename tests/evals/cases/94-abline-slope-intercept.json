{
  "id": "94-abline-slope-intercept",
  "kind": "chart",
  "prompt": "Scatter y against x and add a reference line with slope 2 and intercept 1 using geom_abline.",
  "dataProfile": {
    "fields": [
      { "name": "x", "type": "quantitative" },
      { "name": "y", "type": "quantitative" }
    ],
    "rowCount": 4
  },
  "data": {
    "main": [
      { "x": 0, "y": 1 },
      { "x": 1, "y": 3 },
      { "x": 2, "y": 5 },
      { "x": 3, "y": 7 }
    ]
  },
  "gold": {
    "edition": 1,
    "data": { "name": "main" },
    "layers": [
      {
        "geom": "point",
        "stat": "identity",
        "position": "identity",
        "aes": {
          "x": { "field": "x" },
          "y": { "field": "y" }
        }
      },
      {
        "geom": "abline",
        "stat": "identity",
        "position": "identity",
        "params": { "slope": 2, "intercept": 1 }
      }
    ]
  },
  "expectRefusal": false,
  "notes": "geom_abline with explicit slope/intercept params (#790)."
}
