  "data": {
    "main": [
      { "x": 1, "y": 8 },
      { "x": 2, "y": 12 },
      { "x": 3, "y": 9 },
      { "x": 4, "y": 11 }
    ]
  },
  "gold": {
    "edition": 1,
    "data": { "name": "main" },
    "layers": [
      {
        "geom": "point",
        "stat": "identity",
        "position": "identity",
        "aes": {
          "x": { "field": "x" },
          "y": { "field": "y" }
        }
      },
      {
        "geom": "rule",
        "stat": "identity",
        "position": "identity",
