{
  "id": "94-abline-identity",
  "kind": "chart",
  "prompt": "Scatter observed against predicted and overlay the y = x identity line using geom_abline.",
  "dataProfile": {
    "fields": [
      { "name": "predicted", "type": "quantitative" },
      { "name": "observed", "type": "quantitative" }
    ],
    "rowCount": 4
