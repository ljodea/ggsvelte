  "data": {
    "main": [
      { "predicted": 1, "observed": 1.2 },
      { "predicted": 2, "observed": 1.8 },
      { "predicted": 3, "observed": 3.3 },
      { "predicted": 4, "observed": 3.9 }
    ]
  },
  "gold": {
    "edition": 1,
    "data": { "name": "main" },
    "layers": [
      {
        "geom": "point",
        "stat": "identity",
        "position": "identity",
        "aes": {
          "x": { "field": "predicted" },
          "y": { "field": "observed" }
        }
      },
      {
        "geom": "abline",
        "stat": "identity",
        "position": "identity"
