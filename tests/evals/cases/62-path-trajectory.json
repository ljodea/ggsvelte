      { "x": 0, "y": 0 },
      { "x": 1, "y": 1 },
      { "x": 0.5, "y": 1.5 },
      { "x": 0, "y": 1 },
      { "x": 0.2, "y": 0.2 }
    ]
  },
  "gold": {
    "edition": 2,
    "data": { "name": "main" },
    "layers": [
      {
        "geom": "path",
        "stat": "identity",
