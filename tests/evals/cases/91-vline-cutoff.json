  "prompt": "Plot y vs x with a vertical cutoff line at x = 2.5 via geom_vline.",
  "dataProfile": {
    "fields": [
      { "name": "x", "type": "quantitative" },
      { "name": "y", "type": "quantitative" }
    ],
    "rowCount": 4
