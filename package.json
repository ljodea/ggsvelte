{
  "name": "ggsvelte-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples",
    "spikes/*",
    "benchmarks",
    "benchmarks/competitive"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc -b packages/spec packages/core packages/cli && bun run check:type-contracts && bun run check:scripts-ci-routing && bun run check:scripts && bun run lifecycle:check && bun run comparison:versions:check",
    "check:scripts-ci-routing": "bun node_modules/.bin/tsc -p scripts/ci-routing --noEmit",
    "check:scripts": "bun node_modules/.bin/tsc -p scripts --noEmit",
    "check:type-contracts": "tsc -p packages/spec/type-tests/tsconfig.json",
    "check:svelte": "cd packages/svelte && bun run --bun check",
    "check:examples": "bun node_modules/.bin/tsc -p examples --noEmit",
    "check:docs": "cd apps/docs && bun run --bun check",
    "check:pages-links": "bun scripts/check-pages-links.ts",
    "docs:routes:gen": "bun scripts/gen-docs-routes.ts",
    "docs:routes:check": "bun scripts/gen-docs-routes.ts --check",
    "docs:search:gen": "bun scripts/gen-docs-search.ts",
    "docs:search:check": "bun scripts/gen-docs-search.ts --check",
    "lesson:charts:gen": "bun scripts/gen-lesson-charts.ts",
    "lesson:charts:check": "bun scripts/gen-lesson-charts.ts --check",
    "gallery:previews:gen": "bun scripts/gen-gallery-previews.ts",
    "gallery:previews:check": "bun scripts/gen-gallery-previews.ts --check",
    "gallery:previews:capture": "bun scripts/capture-gallery-lights.ts",
    "theme:shells:gen": "bun scripts/gen-theme-static-shells.ts",
    "theme:shells:check": "bun scripts/gen-theme-static-shells.ts --check",
    "check:docs-metadata": "bun scripts/check-docs-metadata.ts",
    "lint": "bun node_modules/.bin/oxlint .",
    "lint:md": "bun node_modules/.bin/markdownlint-cli2",
    "lint:type-aware": "bun run --bun lint:type-aware:run",
    "lint:type-aware:run": "oxlint --type-aware --deny-warnings .",
    "fmt": "bun node_modules/.bin/oxfmt && bun node_modules/.bin/prettier --write --log-level warn \"**/*.{svelte,md,yml,yaml}\"",
    "fmt:check": "bun node_modules/.bin/oxfmt --check && bun node_modules/.bin/prettier --check --log-level warn \"**/*.{svelte,md,yml,yaml}\"",
    "test": "bun test packages/spec packages/core packages/cli benchmarks scripts tests/evals",
    "test:temporal-parser": "bun test packages/spec/tests/temporal-parse.test.ts packages/spec/tests/temporal-parse-format.test.ts packages/spec/tests/temporal-column.test.ts packages/spec/tests/temporal-helpers.test.ts packages/spec/tests/temporal-scale-schema.test.ts packages/spec/tests/temporal-scale-authoring.test.ts packages/spec/tests/temporal-source-gate.test.ts packages/spec/tests/validate-tier2-temporal-reuse.test.ts packages/spec/tests/validate-tier2-temporal-position.test.ts packages/core/tests/table-temporal.test.ts",
    "test:temporal-pipeline": "bun test packages/core/tests/pipeline-temporal packages/core/tests/ticks.test.ts",
    "test:spikes": "cd spikes/browser && bun run --bun test",
    "test:visual": "bun node_modules/.bin/playwright test --config tests/visual/playwright.config.ts",
    "test:visual:smoke": "bun node_modules/.bin/playwright test --config tests/visual/playwright.config.ts vr.spec.ts",
    "test:interaction-perf": "bun node_modules/.bin/playwright test --config tests/performance/playwright.config.ts",
    "manifest:gen": "bun scripts/gen-manifest.ts",
    "manifest:check": "bun scripts/gen-manifest.ts --check",
    "lifecycle:gen": "bun scripts/gen-lifecycle.ts",
    "lifecycle:check": "bun scripts/gen-lifecycle.ts --check",
    "comparison:versions:sync": "bun scripts/sync-comparison-versions.ts",
    "comparison:versions:check": "bun scripts/sync-comparison-versions.ts --check",
    "scale:children:gen": "bun scripts/gen-scale-children.ts",
    "scale:children:check": "bun scripts/gen-scale-children.ts --check",
    "builder:scales:gen": "bun scripts/gen-builder-scales.ts",
    "builder:scales:check": "bun scripts/gen-builder-scales.ts --check",
    "builder:geoms:gen": "bun scripts/gen-builder-geoms.ts",
    "builder:geoms:check": "bun scripts/gen-builder-geoms.ts --check",
    "geom:children:gen": "bun scripts/gen-geom-children.ts",
    "geom:children:check": "bun scripts/gen-geom-children.ts --check",
    "knip": "bun node_modules/.bin/knip",
    "lint:package": "bun scripts/package-lint.ts",
    "lint:actions": "bun scripts/actionlint.ts",
    "lint:actions:security": "zizmor .github/workflows",
    "support:check": "bun scripts/support-matrix.ts",
    "compat:consumer": "bun scripts/consumer-compat.ts",
    "quickstart:measure": "bun scripts/quickstart-timing.ts",
    "changeset": "changeset",
    "build": "bun run check && cd packages/svelte && bun run --bun build",
    "build:docs": "cd apps/docs && bun run --bun build",
    "build:cloudflare": "bun run build && bun run build:docs && bun run check:pages-links && bun scripts/deployment-artifact.ts",
    "smoke:deployment": "bun scripts/deployment-smoke-cli.ts",
    "schema:emit": "bun packages/spec/scripts/emit-schema.ts",
    "reference:catalogs:gen": "bun scripts/gen-reference-catalogs.ts",
    "reference:catalogs:check": "bun scripts/gen-reference-catalogs.ts --check",
    "test:components": "cd packages/svelte && bun run --bun test && cd ../../apps/docs && bun run --bun test",
    "bench": "cd benchmarks && bun run bench",
    "bench:smoke": "cd benchmarks && bun run bench:smoke",
    "bench:json": "cd benchmarks && bun run bench:json",
    "bench:budgets": "cd benchmarks && bun run bench:budgets",
    "bench:memory": "cd benchmarks && bun run bench:memory",
    "bench:memory:check": "cd benchmarks && bun run bench:memory:check",
    "bench:competitive": "cd benchmarks/competitive && bun run measure",
    "bench:competitive:bundles": "cd benchmarks/competitive && bun run measure:bundles",
    "bench:competitive:browser": "cd benchmarks/competitive && bun run measure:browser",
    "bench:competitive:check": "cd benchmarks/competitive && bun run check:budgets",
    "bench:competitive:full": "cd benchmarks/competitive && bun run measure:bundles:full && bun run measure:browser:full",
    "evals": "bun tests/evals/run.ts",
    "render:fresh": "bun scripts/render-fresh.ts",
    "render:theme-evidence": "bun scripts/render-theme-evidence.ts && Rscript scripts/render-theme-references.R",
    "validator:gen": "bun scripts/gen-plot-validator.ts",
    "validator:check": "bun scripts/gen-plot-validator.ts --check",
    "version": "changeset version && bun scripts/sync-comparison-versions.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@ggsvelte/core": "workspace:*",
    "@ggsvelte/spec": "workspace:*",
    "@playwright/test": "1.61.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "actionlint": "2.0.6",
    "axe-core": "^4.11.1",
    "highlight.js": "^11.11.1",
    "knip": "6.30.0",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pnpm": "11.13.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.23",
    "typescript": "^6.0.3",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "vite": "^8.0.0"
  },
  "packageManager": "bun@1.3.14"
}
