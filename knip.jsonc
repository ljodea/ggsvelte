{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Spikes are retired M0a evidence: kept runnable, excluded from tooling.
  "ignoreWorkspaces": ["spikes/*"],
  // zizmor and Rscript are system-installed tools, not npm dependencies.
  "ignoreBinaries": ["zizmor", "Rscript"],
  // publint + attw are spawned by scripts/package-lint.ts (guarded to run
  // only on built output), which knip's static analysis cannot trace. The same
  // is true for markdownlint-cli2's explicit node_modules/.bin invocation and
  // pnpm (resolved from PATH by the clean-consumer harness).
  "ignoreDependencies": ["publint", "@arethetypeswrong/cli", "markdownlint-cli2", "pnpm"],
  // Root-exported ggplot2 spellings are intentional binding-identical aliases
  // of camelCase scale/coordinate helpers, and declaration tests enforce that contract.
  "ignoreIssues": {
    "packages/spec/src/scale-helpers.ts": ["duplicates"],
    "packages/spec/src/scale-position-helpers.ts": ["duplicates"],
    "packages/spec/src/scale-color-helpers.ts": ["duplicates"],
    "packages/spec/src/scale-color-viridis.ts": ["duplicates"],
    "packages/spec/src/scale-color-stops.ts": ["duplicates"],
    "packages/spec/src/scale-color-hue-grey.ts": ["duplicates"],
    "packages/spec/src/scale-style-helpers.ts": ["duplicates"],
    "packages/spec/src/scale-multi-helpers.ts": ["duplicates"],
    "packages/spec/src/coord-helpers.ts": ["duplicates"],
    "packages/spec/src/guide-helpers.ts": ["duplicates"],
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "tests/visual/**/*.ts", "tests/evals/**/*.ts"],
      "project": ["scripts/**/*.ts", "tests/visual/**/*.ts", "tests/evals/**/*.ts"],
    },
    "packages/spec": {
      // scripts/emit-schema.ts is invoked by the ROOT "schema:emit" script;
      // knip does not trace cross-workspace script paths, so it is an
      // explicit entry here.
      // *-build.ts modules are gen-only (scripts/gen-reference-catalogs.ts);
      // knip does not follow cross-workspace script imports into packages/spec.
      "entry": ["tests/**/*.test.ts", "scripts/emit-schema.ts", "src/*-build.ts"],
      "project": ["src/**", "scripts/**", "tests/**"],
    },
    "packages/core": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**", "tests/**"],
    },
    "packages/svelte": {
      // tests/migrations are upgrade-guide fixtures: read by
      // scripts/migration-fixtures.test.ts via the filesystem (not imports)
      // and type-checked by svelte-check — invisible to knip's graph.
      // src/lib/data/data-contract.ts exists only to be type-checked: it
      // asserts every bundled dataset stays assignable to the plot's data
      // prop, which nothing imports at runtime by design.
      // src/lib/codemod is reached only from bin/ggsvelte-codemod.js, which
      // imports the BUILT dist path — invisible to knip's source graph.
      "entry": [
        "tests/**/*.test.ts",
        "tests/migrations/**",
        // Same story as tests/migrations: codemod fixtures are read from the
        // filesystem by the harness, never imported.
        "tests/codemod/fixtures/**",
        "src/lib/data/data-contract.ts",
        // Compile-time kind→value guard for createPlotLayer (#786); never
        // imported at runtime — same story as data-contract.ts.
        "src/lib/layers/plot-layer-contract.ts",
        "src/lib/codemod/index.ts",
      ],
      "project": ["src/**", "tests/**"],
    },
    "benchmarks": {
      "entry": ["*.bench.ts"],
      "project": ["**/*.ts"],
    },
    "examples": {
      // The corpus: spec.ts/data.ts are consumed by the docs app via the
      // $examples alias and by tests/visual via the generated manifest.
      "entry": ["*/*/spec.ts", "*/*/data.ts", "define.ts", "rng.ts", "manifest.ts"],
      "project": ["**/*.ts"],
    },
    "apps/docs": {
      // svelte.config.js / vite.config.ts are auto-entries via knip's
      // svelte plugin. Component tests (issue #991) are vitest browser entries.
      "entry": ["src/routes/**/+*.ts", "src/lib/**/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "*.{js,ts}"],
      // Imported only from .svelte files / the $examples alias, which knip
      // does not trace. bits-ui is deep-imported only from .svelte.
      // highlight.js: atom-one-dark CSS via app.css + shared scripts/highlight-code
      // (relative import from code-languages.ts). Knip does not follow either.
      "ignoreDependencies": ["@ggsvelte/examples", "bits-ui", "highlight.js"],
    },
  },
}
