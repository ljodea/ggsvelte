{
  // Shared by CLI, vscode-markdownlint, and the local pre-commit hook.
  // All hooks invoke the lockfile-installed binary via bun (see .pre-commit-config.yaml).
  "config": {
    // Prose, tables, and long URLs routinely exceed 80 columns; prettier owns .md layout.
    "MD013": false,
    // Decision notes intentionally continue ordered numbering across subsection breaks.
    "MD029": false,
    // Sibling sections may repeat the same heading text (e.g. "Migration").
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md"],
  // CHANGELOG.md is generated by changesets. Bodies that start with "# title" become
  // ATX H1s under list items (CommonMark allows ≤3-space indent) and trip MD025/MD001
  // on Version Packages PRs — ignore rather than fight generated history.
  "ignores": ["**/node_modules/**", "spikes/**", "**/CHANGELOG.md"],
  "gitignore": true,
}
